# Copy this file to ".env" and put your real key in it.
#
#     cp .env.example .env
#
# Get a key from console.anthropic.com — Settings, then API keys.
#
# The .env file is listed in .gitignore, so your key will never be
# committed to GitHub. This example file has no real key in it, which
# is why it is safe to commit.

ANTHROPIC_API_KEY=sk-ant-your-key-here
